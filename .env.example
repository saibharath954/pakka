# --- Hindsight (memory) ---
# Hindsight Cloud: sign up at https://ui.hindsight.vectorize.io, add the promo code under Billing, create an API key.
HINDSIGHT_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
MUNSHI_BANK_ID=sri-venkateswara-agencies

# --- LLM for reading messy messages (any OpenAI-compatible endpoint; Groq by default) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# llm = LLM reads the message (falls back to rules on bad output); rules = deterministic parser only
MUNSHI_PARSER=llm

# 1 = in-process keyword stand-in instead of Hindsight (tests / no network). Not a demo of Hindsight.
MUNSHI_OFFLINE=0

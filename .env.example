# --- Hindsight (memory) ---
# Hindsight Cloud: sign up at https://ui.hindsight.vectorize.io, add promo code in Billing, create an API key.
HINDSIGHT_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
# Self-hosted instead? `docker compose up hindsight` and set HINDSIGHT_URL=http://localhost:8888 (no key).

# One bank = one company's sales memory.
PAKKA_BANK_ID=sunkiran-solar

# --- LLM for drafting (any OpenAI-compatible endpoint; Groq by default) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Set to 1 to run with an in-process fake memory + template LLM (tests / no network).
PAKKA_OFFLINE=0
